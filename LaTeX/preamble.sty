% RAST manuscript preparation guidelines: section headings bold, subsection and
% subsubsection headings italic (not bold), only first word capitalized.
\usepackage{titlesec}
\titleformat*{\section}{\large\bfseries}
\titleformat*{\subsection}{\normalsize\itshape}
\titleformat*{\subsubsection}{\normalsize\itshape}

